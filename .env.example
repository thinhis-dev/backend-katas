# App
PORT=3000

# Postgres — inside the devcontainer/compose network use host "postgres";
# when running the app on your host (WSL2/local) against dockerized DBs use "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_USER=kata
DB_PASSWORD=kata
DB_NAME=kata

# Redis — same host rule as above ("redis" inside compose, "localhost" on host).
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Host port overrides (only if you ALREADY run Postgres/Redis locally) ---
# Docker Compose auto-reads this file, so setting PG_HOST_PORT here changes BOTH
# the port Docker publishes AND (when you match DB_PORT to it) the port the app
# connects to. If `migration:run` fails with 'password authentication failed for
# user "kata"', you have a local Postgres on 5432 — uncomment these and set
# DB_PORT to match:
# PG_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# DB_PORT=5433
